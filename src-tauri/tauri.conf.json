{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dynamic Island",
  "version": "0.2.0",
  "identifier": "com.dallamond.dynamicisland",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Dynamic Island",
        "width": 480,
        "height": 300,
        "x": -32000,
        "y": -32000,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "shadow": false,
        "focus": false,
        "visible": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection,SpareRendererForSitePerProcess --enable-features=NetworkServiceInProcess2 --disable-gpu --disable-background-networking --disable-component-update --disable-extensions --js-flags=--max-old-space-size=64"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Dallamond",
    "copyright": "© 2026 Dallamond · Licencia MIT",
    "homepage": "https://github.com/Dallamond/Dynamic-Island",
    "category": "Utility",
    "shortDescription": "Dynamic Island para Windows",
    "longDescription": "Isla negra al estilo del iPhone para Windows: música, agentes de IA (Claude Code, Codex, IA local), pomodoro, sistema y utilidades.",
    "licenseFile": "../LICENSE",
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "headerImage": "installer/header.bmp",
        "sidebarImage": "installer/sidebar.bmp",
        "languages": ["Spanish"],
        "installMode": "currentUser"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
